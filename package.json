{
  "name": "goldshore-admin",
  "description": "Goldshore admin dashboard app built with React Router, Vite, and Cloudflare Workers; the standalone gateway worker lives in goldshore-gateway/.",
  "private": true,
  "type": "module",
  "cloudflare": {
    "label": "React Router + Hono Fullstack App",
    "products": [
      "Workers"
    ],
    "categories": [
      "starter"
    ],
    "docs_url": "https://developers.cloudflare.com/workers",
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/d3db20ee-c3bf-4b5c-f1ed-d86021359e00/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/56caa8a9-d3ab-4ac6-32a9-6a5fc686e000/preview",
    "publish": true
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "axios": "^1.16.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "hono": "4.12.25",
    "isbot": "5.1.44",
    "lucide-react": "^1.24.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.18.0",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.1",
    "@cloudflare/workers-types": "^4.20250425.0",
    "@react-router/dev": "7.18.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "24.0.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.110.x"
  },
  "workspaces": [
    "packages/*",
    "goldshore-gateway",
    "goldshore-control-worker"
  ],
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "postinstall": "npm install --workspaces --if-present --ignore-scripts"
  }
}
