// goldshore-gateway — rename target for gs-platform
// Serves: gw.goldshore.ai, gateway.goldshore.ai, ops.goldshore.ai
// Current script name: gs-platform (deploy with new name after staging verification)
{
  "name": "gs-platform",
  "main": "goldshore-gateway/src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "API_BASE": "https://api.goldshore.ai",
    "CORS_ALLOWED": "[\"https://goldshore.ai\",\"https://www.goldshore.ai\",\"https://gw.goldshore.ai\",\"https://gateway.goldshore.ai\",\"https://ops.goldshore.ai\"]",
    "CF_ACCESS_ISS": "https://goldshore.cloudflareaccess.com",
    "CF_ACCESS_JWKS_URL": "https://goldshore.cloudflareaccess.com/cdn-cgi/access/certs"
  },
  // Secrets (set via: wrangler secret put <NAME> --name gs-platform)
  // CF_ACCESS_AUD
  // GATEWAY_AUTH_TOKEN
  "kv_namespaces": [
    {
      // GATEWAY_KV — audit log storage for integration requests
      "binding": "GATEWAY_KV",
      "id": "17840f9b6ac64cb1a51aeff085efe24c"
    },
    {
      "binding": "GS_CONFIG",
      "id": "68f52b467dc0413991b2195ef9081cae"
    }
  ],
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "gs_platform_db",
      "database_id": "9703574e-adb7-481e-8d98-96f8ce5f8a90"
    },
    {
      "binding": "AUDIT_DB",
      "database_name": "gs_audit_db",
      "database_id": "1ae71d76-188f-481b-91d9-db2d39013f68"
    }
  ],
  "services": [
    {
      // Service binding to agent — used for agent.goldshore.ai proxy
      "binding": "AGENT",
      "service": "gs-agent",
      "environment": "prod"
    },
    {
      // Service binding to API — used for /api/* proxy
      "binding": "API_SERVICE",
      "service": "gs-api",
      "environment": "prod"
    },
    {
      // Security / ban check
      "binding": "SECURITY_CHECK",
      "service": "banproof-me"
    },
    {
      // Signals worker
      "binding": "SIGNALS",
      "service": "gs-signals-prod"
    }
  ],
  "secrets_store": {
    "bindings": [
      {
        "binding": "SECRETS",
        "store_id": "b9824d3280c54573a24137c7e7143b33"
      }
    ]
  },
  "routes": [
    { "pattern": "gw.goldshore.ai/*", "zone_name": "goldshore.ai" },
    { "pattern": "gateway.goldshore.ai/*", "zone_name": "goldshore.ai" },
    { "pattern": "ops.goldshore.ai/*", "zone_name": "goldshore.ai" }
  ]
}
